{
  "lambda_function_config": {
    "function_name": "media-pipeline-color-matching",
    "runtime": "python3.9",
    "handler": "lambda_handler.lambda_handler",
    "timeout": 300,
    "memory_size": 1024,
    "environment_variables": {
      "PYTHONPATH": "/var/task"
    }
  },
  "api_gateway_config": {
    "api_name": "media-pipeline-api",
    "stage_name": "prod",
    "endpoints": [
      {
        "path": "/process-images",
        "method": "POST",
        "handler": "lambda_handler.handle_api_gateway_event",
        "cors": true
      }
    ]
  },
  "s3_permissions": {
    "bucket_access": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
    "required_buckets": ["your-media-pipeline-bucket"]
  },
  "deployment_notes": [
    "1. Install dependencies: pip install -r requirements.txt -t .",
    "2. Create deployment package: zip -r deployment.zip .",
    "3. Upload to Lambda or use AWS SAM/CDK for infrastructure",
    "4. Set up S3 bucket with appropriate permissions",
    "5. Configure API Gateway integration",
    "6. Test with sample images"
  ]
}
